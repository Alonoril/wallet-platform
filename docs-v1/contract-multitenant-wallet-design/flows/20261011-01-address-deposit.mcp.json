      "width": 2360,
      "height": 44,
      "strokeColor": "#495057",
      "roughness": 0,
      "text": "API 接入为规划 · Factory/DepositVault 已实现 · 地址发行、部署、风控是三条独立状态轴",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-10-11T02:21:29.465Z",
      "updatedAt": "2026-10-11T02:21:29.465Z",
