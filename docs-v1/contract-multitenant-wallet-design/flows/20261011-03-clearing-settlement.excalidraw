    },
    {
      "id": "20261011-03-clearing-settlement-migration-text",
      "type": "text",
      "x": 256.4,
      "y": 1092.5,
      "width": 727.2,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3955854,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "迁移 Clearing → 同租户登记 Clearing（需配置 Migration 路由）\n同一 SettlementPermit + SETTLEMENT_SIGNER + 独立 Council；双边普通风险检查。\n源 lot 可以尚未到期；importLots 保留原 maturity，不可把迁移当作观察期已通过。\n新 lotId 绑定源池、迁移 operationId、旧 lotId；迁移并非公开支付入口。",
      "originalText": "迁移 Clearing → 同租户登记 Clearing（需配置 Migration 路由）\n同一 SettlementPermit + SETTLEMENT_SIGNER + 独立 Council；双边普通风险检查。\n源 lot 可以尚未到期；importLots 保留原 maturity，不可把迁移当作观察期已通过。\n新 lotId 绑定源池、迁移 operationId、旧 lotId；迁移并非公开支付入口。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-03-clearing-settlement-migration",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-03-clearing-settlement-unknown",
      "type": "rectangle",
      "x": 1260,
      "y": 1020,
      "width": 1120,
      "height": 235,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff0f0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3291690,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "20261011-03-clearing-settlement-unknown-text",
          "type": "text"
        }
      ],
      "updated": 1791687049636,
      "link": null,
      "locked": false
    },
    {
      "id": "20261011-03-clearing-settlement-unknown-text",
      "type": "text",
      "x": 1461.8,
      "y": 1092.5,
      "width": 716.4,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3775248,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "ERC-20 / 原生币直接打入 Clearing：没有 Manager.recordLot，不产生可结算额度。\n后端先记待认领负债、对账并形成案件。\n隔离无 lot 资金只可用余额超出 outstanding 的部分（07）。\n登记 lot 的案件处置必须签 lotsHash 并原子扣减，避免后来重复 settle。",
      "originalText": "ERC-20 / 原生币直接打入 Clearing：没有 Manager.recordLot，不产生可结算额度。\n后端先记待认领负债、对账并形成案件。\n隔离无 lot 资金只可用余额超出 outstanding 的部分（07）。\n登记 lot 的案件处置必须签 lotsHash 并原子扣减，避免后来重复 settle。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-03-clearing-settlement-unknown",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-03-clearing-settlement-note0",
      "type": "rectangle",
      "x": 60,
      "y": 1420,
      "width": 2320,
      "height": 235,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3002332,
      "version": 1,
      "versionNonce": 0,
