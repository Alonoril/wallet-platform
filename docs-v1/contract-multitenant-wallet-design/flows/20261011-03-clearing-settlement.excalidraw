    {
      "id": "20261011-03-clearing-settlement-ledger-text",
      "type": "text",
      "x": 138.0,
      "y": 638.75,
      "width": 324.0,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3622801,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "8 / PG 镜像与账本（规划）\nlot released / movement 去重\n借 Treasury 资产，贷 Clearing 资产\n用户总负债/可用不因结算再增加\n联动 Outbox 和对账 checkpoint",
      "originalText": "8 / PG 镜像与账本（规划）\nlot released / movement 去重\n借 Treasury 资产，贷 Clearing 资产\n用户总负债/可用不因结算再增加\n联动 Outbox 和对账 checkpoint",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-03-clearing-settlement-ledger",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-03-clearing-settlement-migration",
      "type": "rectangle",
      "x": 60,
      "y": 1020,
      "width": 1120,
      "height": 235,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
