      "link": null,
      "locked": false
    },
    {
      "id": "20261011-04-withdrawal-note2-text",
      "type": "text",
      "x": 429.79999999999995,
      "y": 1785.0,
      "width": 1580.4,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2618787,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "Permit：requestId / tenantKey / poolId / token / to / amount / approvalDigest / poolEpoch / poolAssetEpoch / policyEpoch / signerEpoch / validAfter / deadline。\nEIP-712 与外层 EOA nonce 是两种执行凭据；一个 nonce 替换屏障不撤销业务授权。\n各授权有效区间最多一小时（建议默认五分钟），链块时间必须位于有效区间；API 通信签名的有效窗口单独管理。\n原生资产 token=address(0)；U256 使用整数字符串/BigInt，enum 编码为 uint8；接入 schema 见 contracts/interfaces/eip712.json。",
      "originalText": "Permit：requestId / tenantKey / poolId / token / to / amount / approvalDigest / poolEpoch / poolAssetEpoch / policyEpoch / signerEpoch / validAfter / deadline。\nEIP-712 与外层 EOA nonce 是两种执行凭据；一个 nonce 替换屏障不撤销业务授权。\n各授权有效区间最多一小时（建议默认五分钟），链块时间必须位于有效区间；API 通信签名的有效窗口单独管理。\n原生资产 token=address(0)；U256 使用整数字符串/BigInt，enum 编码为 uint8；接入 schema 见 contracts/interfaces/eip712.json。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-04-withdrawal-note2",
      "autoResize": false,
      "lineHeight": 1.25
    },
