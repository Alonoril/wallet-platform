    {
      "id": "20261011-06-risk-isolation-b2-text",
      "type": "text",
      "x": 1556.45,
      "y": 586.25,
      "width": 557.1,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
