    },
    {
      "id": "20261011-06-risk-isolation-b5-text",
      "type": "text",
      "x": 1532.15,
      "y": 1441.25,
      "width": 605.7,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2667337,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "B5 / 有限恢复的硬条件\n适用源/目标 scope 全部开放 + 新 epoch 授权 + 批准路由/策略/资产。\n转出后余额 ≥ 全部剩余案件 reserve + Treasury safetyFloor。\n后端另外扣在途付款、未知入款和资金预留；同集合不重复扣减。\nreserve > 可控余额时禁止普通流出，不静默缩小风险义务。",
      "originalText": "B5 / 有限恢复的硬条件\n适用源/目标 scope 全部开放 + 新 epoch 授权 + 批准路由/策略/资产。\n转出后余额 ≥ 全部剩余案件 reserve + Treasury safetyFloor。\n后端另外扣在途付款、未知入款和资金预留；同集合不重复扣减。\nreserve > 可控余额时禁止普通流出，不静默缩小风险义务。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-06-risk-isolation-b5",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-06-risk-isolation-note0",
      "type": "rectangle",
