    },
    {
      "id": "20261011-06-risk-isolation-b3-text",
      "type": "text",
      "x": 1535.75,
      "y": 871.25,
      "width": 598.5,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2665395,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "B3 / 核定义务、可控量、缺口（规划）\n按控制实际生效顺序回填，已转往其他本租户池则追加 scoped control。\nreserve 使用绝对金额 + CAS version；重复告警不重复累计。\n不同案件预留相加；同一义务交叠由后端 reserve allocations 去重。\n冻结原 Vault 或某一个池成功，不代表整条链已完全受控。",
      "originalText": "B3 / 核定义务、可控量、缺口（规划）\n按控制实际生效顺序回填，已转往其他本租户池则追加 scoped control。\nreserve 使用绝对金额 + CAS version；重复告警不重复累计。\n不同案件预留相加；同一义务交叠由后端 reserve allocations 去重。\n冻结原 Vault 或某一个池成功，不代表整条链已完全受控。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-06-risk-isolation-b3",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-06-risk-isolation-b4",
