    {
      "id": "20261011-06-risk-isolation-note2-text",
      "type": "text",
      "x": 1798.6,
      "y": 1876.25,
      "width": 442.8,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
