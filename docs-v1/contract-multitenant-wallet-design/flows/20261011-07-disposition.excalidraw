      "locked": false
    },
    {
      "id": "20261011-07-disposition-note2-text",
      "type": "text",
      "x": 669.2,
      "y": 1895.0,
      "width": 1101.6,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
