    {
      "id": "20261011-08-custody-governance-return-text",
      "type": "text",
      "x": 1901.25,
      "y": 1178.75,
      "width": 337.5,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
