    },
    {
      "id": "20261011-12-evm-contract-functions-subtitle",
      "type": "text",
      "x": 60,
      "y": 90,
      "width": 4100,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 539768958,
      "version": 1,
      "versionNonce": 539768958,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791691240838,
      "link": null,
      "locked": false,
      "text": "横向看合约职责；纵向读入口与内部校验。绿线＝资产移动；点线＝复用 / 控制引用 / 另次调用。",
      "originalText": "横向看合约职责；纵向读入口与内部校验。绿线＝资产移动；点线＝复用 / 控制引用 / 另次调用。",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-12-evm-contract-functions-rule",
      "type": "text",
      "x": 60,
      "y": 142,
      "width": 4100,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#a61e4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1936299163,
      "version": 1,
      "versionNonce": 1936299163,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791691240838,
      "link": null,
      "locked": false,
      "text": "每个资金入口均执行其对应的权限、资产、签名与实时控制校验；任一失败均 revert。具体合约调用顺序见配套说明。",
      "originalText": "每个资金入口均执行其对应的权限、资产、签名与实时控制校验；任一失败均 revert。具体合约调用顺序见配套说明。",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
