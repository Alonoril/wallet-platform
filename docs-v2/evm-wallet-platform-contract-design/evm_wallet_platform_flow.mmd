flowchart TD
  subgraph S1["① 创建与分配充值合约"]
    U["租户用户 / Wallet API"] --> DF["DepositFactory / Registry"]
    DF -->|"CREATE2：tenant + user + chain + version"| DV["DepositVault：独立充值合约"]
  end

  subgraph S2["② 充值审查与观察期"]
    DV -->|"原生币 / ERC20 入账"| IDX["wallet-platform-rust：来源解析 + depositId + 链终局"]
    IDX --> RISK{"来源风控和地址冻结检测通过？"}
    RISK -->|"通过"| WATCH["观察期 T：每笔充值独立计时"]
    WATCH --> PRE{"观察期到期 / 归集前复核通过？"}
  end

  subgraph S3["③ 污染地址隔离与轮换"]
    RISK -->|"失败"| LOCK["Quarantine：禁提现、禁归集"]
    PRE -->|"失败"| LOCK
    LOCK --> RETIRE["Retire 旧地址：停止业务监听与入账"]
    RETIRE -->|"版本 +1"| DF
    RETIRE --> OLD["旧地址仍可能被动收到转账；保留审计记录"]
  end

  subgraph S4["④ 统一多签提现：未归集余额 / 热池权益"]
    WATCH -->|"用户发起提现"| WRISK{"出金风控通过且有清洁可用余额？"}
    WRISK -->|"通过"| MREQUEST["Milon App：统一 requestId，原子预留本金和费用"]
    MREQUEST --> MVOTE["Milon 多签执行 ApproveWithdrawal，等待业务终局"]
    MVOTE --> CERT["wallet-platform-rust：汇集节点跨链签名，中继原 Permit"]
    CERT --> SOURCE{"已批准的付款源？"}
    SOURCE -->|"未归集余额"| WITHDRAW["DepositVault 提现：拟新增验签和共享订单入口"]
    SOURCE -->|"热钱包余额"| HOUT["HotVault.executeWithdrawal：验签、风控、共享订单消费"]
    WITHDRAW --> EXT["用户指定外部地址"]
    HOUT --> EXT
    EXT --> FINAL["EVM 付款最终确认"]
    FINAL --> RESULT["wallet-platform-rust：收集可信结果，中继至 Milon"]
    RESULT --> PAID["Milon ApplyWithdrawalResult：幂等结算预留"]
    WRISK -->|"失败"| HOLD["拒绝 / 冻结本次提现"]
  end

  subgraph S5["⑤ 热钱包池动态分配"]
    PRE -->|"通过"| PM["HotPoolManager：最多 20 / 50 个 HotVault"]
    PM --> CAP{"有健康热钱包且剩余容量足够？"}
    CAP -->|"有"| SWEEP["DepositVault.sweep → HotVault"]
    CAP -->|"没有"| CNT{"现有热钱包数量小于上限？"}
    CNT -->|"是"| NEW["部署新 HotVault"]
    NEW --> SWEEP
    CNT -->|"否"| OLDEST["选择最旧且风险正常的 HotVault"]
    SWEEP --> HOT["HotVault：目标持仓上限 100,000 USD"]
    HOT -->|"用户申请提取热池权益"| WRISK
  end

  subgraph S6["⑥ 冷钱包归集与容量回收"]
    OLDEST --> CCHECK{"资产可转移且出冷风控通过？"}
    CCHECK -->|"是"| SEND["HotVault.sweepToCold：Relayer 支付 Gas"]
    SEND --> COLD["离线 Cold EOA：系统仅保存公开地址"]
    SEND --> RELEASE["旧 HotVault 释放容量"]
    RELEASE --> SWEEP
    CCHECK -->|"否"| QUEUE["待归集队列 / 人工处置，不强制超额"]
  end

  subgraph S7["⑦ 归集后风险应急"]
    HOT --> POST{"归集后发现关联黑钱？"}
    POST -->|"是"| FREEZE["冻结受影响 HotVault，停止出金与转冷；链上追踪"]
    POST -->|"否"| NORMAL["正常运营，持续风险监控"]
    FREEZE -->|"追溯来源"| LOCK
    COLD -.->|"事后发现污染"| COLD_RISK["冷钱包离线隔离 + 合规处置，不支持链上撤销"]
  end

  subgraph S8["⑧ EVM 与 Milon 权益映射"]
    RISK -->|"初审通过，来源已终局"| CREDIT["Rust：映射 tenantKey / userKey / assetKey，汇集入账授权"]
    CREDIT --> MBAL["Milon CreditDeposit：来源去重，记 available / riskHeld"]
    MBAL -.->|"提供可用权益与用户授权校验依据"| WRISK
    LOCK --> RUPDATE["Rust：同步 EVM 限制与 Milon 风险预留"]
    SWEEP -.-> MOVEMENT["Rust：内部资金移动，只更新托管位置，不再次入账"]
    SEND -.-> MOVEMENT
  end

  classDef danger fill:#fee2e2,stroke:#f87171,color:#991b1b;
  classDef money fill:#d1fae5,stroke:#34d399,color:#065f46;
  classDef hot fill:#fef3c7,stroke:#f59e0b,color:#92400e;
  classDef milon fill:#e0e7ff,stroke:#6366f1,color:#312e81;
  classDef bridge fill:#e0f2fe,stroke:#0ea5e9,color:#0c4a6e;
  class LOCK,RETIRE,OLD,HOLD,FREEZE,COLD_RISK danger;
  class WITHDRAW,HOUT,EXT,SEND,COLD,RELEASE,FINAL money;
  class PM,CAP,CNT,OLDEST,NEW,SWEEP,HOT hot;
  class MREQUEST,MVOTE,PAID,MBAL milon;
  class IDX,CERT,RESULT,CREDIT,RUPDATE,MOVEMENT bridge;
