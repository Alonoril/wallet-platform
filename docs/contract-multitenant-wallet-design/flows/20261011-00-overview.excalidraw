      "seed": 2360501,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "ColdVault 冷池\nTreasury 受控转冷\nreturnToTreasury：每笔 Council\n只能回登记 Treasury\n普通出金与 Treasury 共用预算",
      "originalText": "ColdVault 冷池\nTreasury 受控转冷\nreturnToTreasury：每笔 Council\n只能回登记 Treasury\n普通出金与 Treasury 共用预算",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-00-overview-cold",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-00-overview-note0",
      "type": "rectangle",
      "x": 65,
