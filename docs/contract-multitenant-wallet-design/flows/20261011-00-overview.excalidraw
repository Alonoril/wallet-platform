    {
      "id": "20261011-00-overview-cold-text",
      "type": "text",
      "x": 1744.2,
      "y": 1331.25,
      "width": 291.6,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
