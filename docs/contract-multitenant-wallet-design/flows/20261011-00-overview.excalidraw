    },
    {
      "id": "20261011-00-overview-note0-text",
      "type": "text",
      "x": 151.45,
      "y": 1652.5,
      "width": 917.1,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2426529,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "重点 1：充值最终性与风险审查独立；归集/结算/转冷是内部资产迁移，不重复增加用户余额。\n重点 2：txHash、批次外层成功、单次 revert 都不能替代 requestStatus / operationStatus 与最终事件。",
      "originalText": "重点 1：充值最终性与风险审查独立；归集/结算/转冷是内部资产迁移，不重复增加用户余额。\n重点 2：txHash、批次外层成功、单次 revert 都不能替代 requestStatus / operationStatus 与最终事件。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-00-overview-note0",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-00-overview-note1",
      "type": "rectangle",
      "x": 1230,
      "y": 1610,
      "width": 1135,
      "height": 130,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff0f0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1943942,
      "version": 2,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "20261011-00-overview-note1-text",
          "type": "text"
        }
      ],
      "updated": 1791687049636,
      "link": null,
      "locked": false
    },
    {
      "id": "20261011-00-overview-note1-text",
      "type": "text",
      "x": 1397.9,
      "y": 1652.5,
      "width": 799.2,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2427500,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "重点 3：未归集风险 → 原 Vault HOLD；已归集风险 → 实际持有池 HOLD + 预留 + 下游追溯。\n冻结不能阻止第三方入款；已外付资产不可由合约撤回；用户债权、风险义务与资金缺口持续记账。",
      "originalText": "重点 3：未归集风险 → 原 Vault HOLD；已归集风险 → 实际持有池 HOLD + 预留 + 下游追溯。\n冻结不能阻止第三方入款；已外付资产不可由合约撤回；用户债权、风险义务与资金缺口持续记账。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-00-overview-note1",
      "autoResize": false,
      "lineHeight": 1.25
    },
