    {
      "id": "20261011-01-address-deposit-note0-text",
      "type": "text",
      "x": 253.3,
      "y": 611.25,
      "width": 653.4,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3068360,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "发行后旧地址用途不重绑；未部署且有余额是正常状态。\n链上盐/标识不是密钥。API 租户不能自选 salt、Manager、路由或 Treasury。\n充值归属由永久发行映射确定；用户身份和订单不由链日志自动恢复。",
      "originalText": "发行后旧地址用途不重绑；未部署且有余额是正常状态。\n链上盐/标识不是密钥。API 租户不能自选 salt、Manager、路由或 Treasury。\n充值归属由永久发行映射确定；用户身份和订单不由链日志自动恢复。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-01-address-deposit-note0",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-01-address-deposit-note1",
      "type": "rectangle",
      "x": 60,
      "y": 1650,
      "width": 2320,
      "height": 165,
      "angle": 0,
      "strokeColor": "#e03131",
