    },
    {
      "id": "20261011-01-address-deposit-note1-text",
      "type": "text",
      "x": 831.65,
      "y": 1698.75,
      "width": 776.7,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3069331,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "API 重点：available、risk_pending、held、pending_chain、ledger_seq 必须独立披露。\n不把非最终事件、未知资产或伪造 token 事件计入可用余额；故障返回可追踪 pending。\n从 Deposit 到 Clearing/Treasury 是内部移动，用户已入账债权不因归集再次增加。",
      "originalText": "API 重点：available、risk_pending、held、pending_chain、ledger_seq 必须独立披露。\n不把非最终事件、未知资产或伪造 token 事件计入可用余额；故障返回可追踪 pending。\n从 Deposit 到 Clearing/Treasury 是内部移动，用户已入账债权不因归集再次增加。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-01-address-deposit-note1",
      "autoResize": false,
      "lineHeight": 1.25
    },
