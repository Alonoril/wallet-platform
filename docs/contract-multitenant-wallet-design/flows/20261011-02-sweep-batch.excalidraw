    },
    {
      "id": "20261011-02-sweep-batch-note0-text",
      "type": "text",
      "x": 295.1,
      "y": 1748.75,
      "width": 649.8,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2642091,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "新充值或粉尘在签名后到达 → 余额变动使归集失败；不得自动扩大 amount。\n重新扫描和审查整个资产余额，再建立批准与授权。\n资金来源的干净程度不是余额相等能证明的；冻结竞态按最终链顺序处理（06）。",
      "originalText": "新充值或粉尘在签名后到达 → 余额变动使归集失败；不得自动扩大 amount。\n重新扫描和审查整个资产余额，再建立批准与授权。\n资金来源的干净程度不是余额相等能证明的；冻结竞态按最终链顺序处理（06）。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-02-sweep-batch-note0",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-02-sweep-batch-note1",
