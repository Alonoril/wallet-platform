    {
      "id": "20261011-02-sweep-batch-note1-text",
      "type": "text",
      "x": 1409.15,
      "y": 1737.5,
      "width": 821.7,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
