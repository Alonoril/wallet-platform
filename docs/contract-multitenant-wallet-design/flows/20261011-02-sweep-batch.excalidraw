    {
      "id": "20261011-02-sweep-batch-ledger-text",
      "type": "text",
      "x": 672.35,
      "y": 1403.75,
      "width": 1095.3,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
