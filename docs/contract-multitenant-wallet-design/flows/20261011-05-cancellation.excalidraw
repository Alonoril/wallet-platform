    {
      "id": "20261011-05-cancellation-executed-text",
      "type": "text",
      "x": 1864.5,
      "y": 736.25,
      "width": 351.0,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3152837,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "最终 requestStatus = Executed\nWithdrawalExecuted 与订单效果一致\n取消不会逆转已执行付款\n订单仍按 FINAL_PAID 结算\n不退款、不在新 Treasury 重签同活跃订单",
      "originalText": "最终 requestStatus = Executed\nWithdrawalExecuted 与订单效果一致\n取消不会逆转已执行付款\n订单仍按 FINAL_PAID 结算\n不退款、不在新 Treasury 重签同活跃订单",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-05-cancellation-executed",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
