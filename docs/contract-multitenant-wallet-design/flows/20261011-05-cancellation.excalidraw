    {
      "id": "20261011-05-cancellation-cancelled-text",
      "type": "text",
      "x": 1048.1,
      "y": 1071.25,
      "width": 343.8,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3218865,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "最终 requestStatus = Cancelled\n规范链 OperationCancelled + 状态核对\n确认无已付款经济效果\n旧 Permit 永久不能消费此 ID\n再释放/转风险用户 Hold，发 cancelled",
      "originalText": "最终 requestStatus = Cancelled\n规范链 OperationCancelled + 状态核对\n确认无已付款经济效果\n旧 Permit 永久不能消费此 ID\n再释放/转风险用户 Hold，发 cancelled",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-05-cancellation-cancelled",
      "autoResize": false,
      "lineHeight": 1.25
    },
