    },
    {
      "id": "20261011-05-cancellation-uncertain-text",
      "type": "text",
      "x": 1872.15,
      "y": 1071.25,
      "width": 335.7,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3263531,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "未最终 / Unknown / Reorged / 查不到\n保持用户 Hold 和签名 gate 关闭\n恢复索引覆盖，追踪所有授权与交易族\n重播稳定取消命令并确认结果\n不能把 timeout 当作“未付款”",
      "originalText": "未最终 / Unknown / Reorged / 查不到\n保持用户 Hold 和签名 gate 关闭\n恢复索引覆盖，追踪所有授权与交易族\n重播稳定取消命令并确认结果\n不能把 timeout 当作“未付款”",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-05-cancellation-uncertain",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-05-cancellation-note0",
      "type": "rectangle",
      "x": 60,
      "y": 1390,
      "width": 1120,
      "height": 300,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff0f0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2310980,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "20261011-05-cancellation-note0-text",
