      "height": 44,
      "strokeColor": "#495057",
      "roughness": 0,
      "text": "真实入口：DispositionController.executeDisposition · Domain = Milon Disposition / 1 / chainId / Controller",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-10-11T02:22:53.958Z",
