      "link": null,
      "locked": false
    },
    {
      "id": "20261011-09-events-ledger-recovery-note0-text",
      "type": "text",
      "x": 726.8,
      "y": 2025.0,
      "width": 986.4,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3765538,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "通用接入：HTTP nonce 每次尝试更新，Idempotency-Key/商户订单保持不变；同键不同业务载荷拒绝。\nAPI 通信身份、EIP-712 资金授权和 EOA 交易签名各自分域；不要把业务命令变成任意 digest / calldata 签名服务。",
      "originalText": "通用接入：HTTP nonce 每次尝试更新，Idempotency-Key/商户订单保持不变；同键不同业务载荷拒绝。\nAPI 通信身份、EIP-712 资金授权和 EOA 交易签名各自分域；不要把业务命令变成任意 digest / calldata 签名服务。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-09-events-ledger-recovery-note0",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-09-events-ledger-recovery-edge-0",
      "type": "arrow",
      "x": 548,
      "y": 355,
      "width": 94,
