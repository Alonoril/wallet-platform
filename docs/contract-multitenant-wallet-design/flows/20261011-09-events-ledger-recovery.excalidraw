      "locked": false
    },
    {
      "id": "20261011-09-events-ledger-recovery-authorization-text",
      "type": "text",
      "x": 1013.0,
      "y": 1126.25,
      "width": 414.0,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4677307,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "授权事实（规划）\nPREPARED → SIGNING_POSSIBLE\n→ SIGNED / UNCERTAIN\n→ ONCHAIN_EXECUTED\n或 ONCHAIN_CANCELLED / INVALIDATED_FINAL。\noperation/requestId 在具体校验合约永久保存。\n签名不确定时不能认定“没有授权”。",
      "originalText": "授权事实（规划）\nPREPARED → SIGNING_POSSIBLE\n→ SIGNED / UNCERTAIN\n→ ONCHAIN_EXECUTED\n或 ONCHAIN_CANCELLED / INVALIDATED_FINAL。\noperation/requestId 在具体校验合约永久保存。\n签名不确定时不能认定“没有授权”。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-09-events-ledger-recovery-authorization",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-09-events-ledger-recovery-transaction",
