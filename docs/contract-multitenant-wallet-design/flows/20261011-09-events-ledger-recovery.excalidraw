    {
      "id": "20261011-09-events-ledger-recovery-transaction-text",
      "type": "text",
      "x": 1854.4,
      "y": 1126.25,
      "width": 331.2,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4449122,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "外层 EOA 交易（规划）\nPREPARED → SIGNING_POSSIBLE\n→ SIGNED → BROADCAST → INCLUDED\n→ FINAL_SUCCESS / FINAL_REVERT\n或 UNCERTAIN；重组保留证据版本。\nEOA nonce 只管理一次外层尝试。\nFINAL_REVERT 不能代替业务永久取消。",
      "originalText": "外层 EOA 交易（规划）\nPREPARED → SIGNING_POSSIBLE\n→ SIGNED → BROADCAST → INCLUDED\n→ FINAL_SUCCESS / FINAL_REVERT\n或 UNCERTAIN；重组保留证据版本。\nEOA nonce 只管理一次外层尝试。\nFINAL_REVERT 不能代替业务永久取消。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-09-events-ledger-recovery-transaction",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-09-events-ledger-recovery-reorg",
      "type": "rectangle",
      "x": 60,
      "y": 1450,
      "width": 720,
      "height": 340,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fff0f0",
