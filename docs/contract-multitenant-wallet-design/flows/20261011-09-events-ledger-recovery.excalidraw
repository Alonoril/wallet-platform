    {
      "id": "20261011-09-events-ledger-recovery-business-text",
      "type": "text",
      "x": 212.10000000000002,
      "y": 1126.25,
      "width": 415.79999999999995,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4144228,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791687049636,
      "link": null,
      "locked": false,
      "text": "业务状态（示意，规划）\nRECEIVED → HELD → APPROVED\n→ AUTHORIZATION_POSSIBLE\n→ AUTHORIZED → EXECUTING\n→ FINAL_PAID\n或 CANCELLING → FINAL_CANCELLED。\n一个经济订单永久绑定请求域、金额/资产/收款人。",
      "originalText": "业务状态（示意，规划）\nRECEIVED → HELD → APPROVED\n→ AUTHORIZATION_POSSIBLE\n→ AUTHORIZED → EXECUTING\n→ FINAL_PAID\n或 CANCELLING → FINAL_CANCELLED。\n一个经济订单永久绑定请求域、金额/资产/收款人。",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "20261011-09-events-ledger-recovery-business",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "20261011-09-events-ledger-recovery-authorization",
      "type": "rectangle",
      "x": 860,
      "y": 1070,
